{
    "name": "WP2 DE-LU Causal Discovery (agg4h, fast validation)",
    "n_gpu": 1,
    "arch": {
        "type": "PredictModel",
        "args": {
            "d_model": 256,
            "n_head": 4,
            "n_layers": 1,
            "ffn_hidden": 256,
            "drop_prob": 0,
            "tau": 100
        }
    },
    "data_loader": {
        "type": "TimeseriesDataLoader",
        "args": {
            "data_dir": "../data/processed/causalformer_input_agg4h.csv",
            "batch_size": 128,
            "time_step": 32,
            "output_window": 31,
            "feature_dim": 1,
            "output_dim": 1,
            "shuffle": true,
            "validation_split": 0.1,
            "num_workers": 0
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "masked_mse_torch",
    "metrics": [
        "masked_mse_torch"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 50,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 100,
        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 1,
        "monitor": "min val_loss",
        "early_stop": 10,
        "lam": 1e-10,
        "tensorboard": false
    },
    "explainer": {
        "m": 1,
        "n": 2
    }
}
